# BIST Production System — required environment variables
# Copy this file to .env for local development and fill in real values.
# NEVER commit .env or real secret values to source control.

# Supabase Postgres connection string.
# Must use the Supavisor pooler host (the direct db.<ref>.supabase.co host is IPv6-only).
# Format: postgresql://postgres.<project_ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-your-region.pooler.supabase.com:5432/postgres

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public API key (safe for frontend)
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (BACKEND ONLY — never expose to the frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Port for the API server (set automatically by Replit in development)
PORT=8080

# Public base URL of the app. Without it the lead link inside a WhatsApp
# notification is a bare path and cannot be opened from the phone.
PUBLIC_APP_URL=https://your-app.example

# CRM lead intake webhook shared-secret header (x-crm-intake-secret)
CRM_INTAKE_SECRET=replace-with-a-long-random-secret

# CRM salesperson notifications via n8n. Set CRM_NOTIFY_ENABLED=false to disable.
CRM_NOTIFY_ENABLED=true
CRM_NOTIFY_WEBHOOK_URL=https://your-n8n-host.example/webhook/crm-notify
