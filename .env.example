# BIST Production System — required environment variables
# Copy this file to .env for local development and fill in real values.
# NEVER commit .env or real secret values to source control.

# Supabase Postgres connection string.
# Must use the Supavisor pooler host (the direct db.<ref>.supabase.co host is IPv6-only).
# Format: postgresql://postgres.<project_ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-your-region.pooler.supabase.com:5432/postgres

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public API key (safe for frontend)
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (BACKEND ONLY — never expose to the frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Port for the API server (set automatically by Replit in development)
PORT=8080
