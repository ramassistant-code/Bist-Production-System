modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
SYNC_SERVICE_URL = "https://syncdbandmonday-production-9e87.up.railway.app"
SYNC_ENV = "production"
INVOICE_NOTIFY_ENABLED = "true"
INVOICE_WEBHOOK_URL = "https://rambist.app.n8n.cloud/webhook/53bf79df-0bf3-43a3-9524-9bba8c2d783c/invoice-details/production"
PUBLIC_APP_URL = "https://bist-production-system.replit.app"
INVOICE4U_RETURN_URL = "https://bist-production-system.replit.app/payment-done"
VITE_APP_ENV = "PROD"

[nix]
channel = "stable-25_05"

