#!/usr/bin/env bash
# Pre-commit hook: block commits that contain GitHub Personal Access Tokens (PATs).
#
# Patterns detected:
#   ghp_...         Classic GitHub PAT (40 chars total)
#   github_pat_...  Fine-grained GitHub PAT (~93 chars total)
#
# Install via:  bash scripts/install-hooks.sh
# Or manually:  git config core.hooksPath scripts/hooks

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Patterns for GitHub PATs
PAT_PATTERNS=(
  'ghp_[A-Za-z0-9]{36}'
  'github_pat_[A-Za-z0-9_]{82}'
)

found=0

for pattern in "${PAT_PATTERNS[@]}"; do
  # Check staged diff for the pattern
  matches=$(git diff --cached --unified=0 | grep '^+' | grep -E "$pattern" || true)
  if [[ -n "$matches" ]]; then
    found=1
    echo -e "${RED}ERROR: Possible GitHub Personal Access Token detected in staged changes.${NC}"
    echo -e "${YELLOW}Pattern matched: ${pattern}${NC}"
    echo ""
    echo "Commit blocked to prevent secret exposure."
    echo ""
    echo "To fix:"
    echo "  1. Remove the token from your staged files."
    echo "  2. Store secrets in Replit Secrets (environment variables) instead."
    echo "  3. If you believe this is a false positive, use:"
    echo "       git commit --no-verify"
    echo "     (only do this if you are certain no real token is present)"
    echo ""
    echo "Tip: The .replit [userenv] section is a known risk location."
    echo "     Never paste a token there — use Replit Secrets instead."
  fi
done

if [[ $found -ne 0 ]]; then
  exit 1
fi

exit 0
